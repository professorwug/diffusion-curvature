        "processed_data/vmi_gate_v2.csv"
    shell:
        "pixi run python vmi_gate_v2.py"

rule v5_gate:
    output:
        "processed_data/v5_gate.csv"
    shell:
        "pixi run python v5_gate.py"

# S2 — tps frontier: VMI (pairs) vs trace-H0 (counts) on paired walks
rule tps_ladder:
    output:
        "processed_data/vmi_tps_ladder.csv"
    shell:
        "pixi run python vmi_tps_ladder.py"

# S3 — heteroskedastic slip noise: entropy vs action-conditioned channels
rule noise:
    output:
        "processed_data/vmi_noise.csv"
    shell:
        "pixi run python vmi_noise.py"

rule render_report:
    input:
        "report.qmd"
    output:
        "report.pdf"
    shell:
        "uv run quarto render report.qmd --to pdf"

