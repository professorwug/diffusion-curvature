# Stage-0 exact-target probes (no training; print-only)
rule stage0_probes:
    output:
        touch("processed_data/.stage0_done")
    shell:
        "pixi run python exact_mi_probe.py && "
        "pixi run python exact_mi_density_probe.py && "
        "pixi run python exact_renyi_probe.py && "
        "pixi run python gap_probe.py"

