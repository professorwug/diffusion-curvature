"""Snakefile for experiments/11-successor-curvatures.

Run:
    cd experiments/11-successor-curvatures
    pixi run snakemake -c1 all                        # production sweep
    pixi run snakemake -c1 --config test_run=1 all    # tiny sweep
"""

TEST_RUN = bool(int(config.get("test_run", 0)))
EXTRA = "--test-run" if TEST_RUN else ""


onsuccess:
    shell("pixi run python ../../.zetteldev/publish_figure.py --sync 11-successor-curvatures || true")


rule all:
    input:
        "figures/tau_colosseum_correlation.png",
        "figures/tau_sadspheres_auc.png",


rule sweep:
    output:
        "processed_data/metrics.csv",
    shell:
        "pixi run python main.py --out {output} " + EXTRA


rule plot_colosseum:
    input:
        "processed_data/metrics.csv",
    output:
        png="figures/tau_colosseum_correlation.png",
        svg="figures/tau_colosseum_correlation.svg",
    shell:
        "pixi run python plot_correlation.py --metrics {input} "
        "--out figures/tau_colosseum_correlation"


